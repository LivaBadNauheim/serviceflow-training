# Supabase-Projekt (eigenes, separates Projekt – nicht das der echten Liva-Seite)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PINs für Login (frei wählbar, beliebige Länge, nur Ziffern empfohlen)
POS_USER_PIN=
POS_ADMIN_PIN=

# Zufälliger, langer String zum Signieren des Login-Cookies
# z.B. erzeugen mit: openssl rand -hex 32
SESSION_SECRET=

# Belegdrucker (2x Epson TM-m30III, ePOS-Print über WLAN) – optional.
# Küche = Essen, Theke = Getränke. Bonnieren schickt jede Position
# automatisch an den passenden Drucker. Ohne beide IPs wird der
# "Bonnieren"-Button einfach nicht angezeigt; ist nur eine der beiden
# gesetzt, funktioniert Bonnieren trotzdem – nur eben nur für die Gruppe
# mit konfiguriertem Drucker (die andere Gruppe meldet einen Fehler).
NEXT_PUBLIC_DRUCKER_IP_ESSEN=
NEXT_PUBLIC_DRUCKER_IP_GETRAENKE=
# auf "true" setzen, falls beide Drucker über HTTPS mit eigenem Zertifikat
# erreichbar gemacht wurden (siehe README)
NEXT_PUBLIC_DRUCKER_HTTPS=false
