# Supabase-Projekt (eigenes, separates Projekt – nicht das der echten Liva-Seite)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PINs für Login (frei wählbar, beliebige Länge, nur Ziffern empfohlen)
POS_USER_PIN=
POS_ADMIN_PIN=

# Zufälliger, langer String zum Signieren des Login-Cookies
# z.B. erzeugen mit: openssl rand -hex 32
SESSION_SECRET=

# Belegdrucker (Epson TM-m30III, ePOS-Print über WLAN) – optional.
# Ohne IP wird der "Beleg drucken"-Button einfach nicht angezeigt.
NEXT_PUBLIC_DRUCKER_IP=
# auf "true" setzen, falls der Drucker über HTTPS mit eigenem Zertifikat
# erreichbar gemacht wurde (siehe README)
NEXT_PUBLIC_DRUCKER_HTTPS=false
